prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: uil
Description: Motif User Interface Language compiler library
Version: @PROJECT_VERSION@
Requires: mrm motif
Cflags: -I${includedir}
Libs: -L${libdir} -lUil
Libs.private: -lm
