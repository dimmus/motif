prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: motif
Description: Motif user interface toolkit
Version: @PROJECT_VERSION@
Requires: xt x11
Requires.private: @MOTIF_PC_XM_REQUIRES_PRIVATE@
Cflags: -I${includedir}
Libs: -L${libdir} -lXm
Libs.private: @MOTIF_PC_XM_LIBS_PRIVATE@
