prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@MOTIF_PC_LIBDIR@
includedir=@MOTIF_PC_INCLUDEDIR@

Name: motif
Description: Motif user interface toolkit
Version: @PROJECT_VERSION@
Requires: @MOTIF_PC_XM_REQUIRES@
Requires.private: @MOTIF_PC_XM_REQUIRES_PRIVATE@
Cflags: -I${includedir}
Libs: -L${libdir} -lXm
Libs.private: @MOTIF_PC_XM_LIBS_PRIVATE@
