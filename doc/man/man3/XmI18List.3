.SH "NAME"
\fBXmI18ListGetSelectedRows\fP,
\fBXmI18ListGetSelectedRowArray\fP,
\fBXmI18ListSelectItems\fP,
\fBXmI18ListDeselectItems\fP,
\fBXmI18ListSelectAllItems\fP,
\fBXmI18ListSelectRow\fP,
\fBXmI18ListDeselectRow\fP,
\fBXmI18ListToggleRow\fP,
\fBXmI18ListMakeRowVisible\fP,
\fBXmI18ListDoSearch\fP,
\fBXmI18ListFindRow\fP,
\fBXm18IListUnselectItem\fP,
\fBXm18IListUnselectAllItems\fP \(em internal functions of the list inside a MultiList
.iX "XmI18List"
.iX "MultiList functions" "XmI18ListSelectRow"
.SH "SYNOPSIS"
.PP
.nf
#include <Xm/MultiListP\&.h>
.PP
