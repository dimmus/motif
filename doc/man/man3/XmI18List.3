\fBint \fBrow\fR\fR);
\fBBoolean \fBXmI18ListDoSearch\fP\fR(
\fBWidget \fBw\fR\fR,
\fBString \fBstr\fR\fR,
\fBBoolean \fBreset\fR\fR);
\fBXmMultiListRowInfo *\fBXmI18ListFindRow\fP\fR(
