\fBint *\fBnum_rows\fR\fR);
\fBvoid \fBXmI18ListSelectItems\fP\fR(
\fBXmI18ListWidget \fBw\fR\fR,
\fBXmString \fBitem\fR\fR,
\fBint \fBcolumn\fR\fR,
\fBBoolean \fBnotify\fR\fR);
\fBvoid \fBXmI18ListDeselectItems\fP\fR(
