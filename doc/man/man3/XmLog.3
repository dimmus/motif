\fBconst char *\fBname\fR\fR,
\fBconst char *\fBcolor\fR\fR);
\fBvoid \fBXmLogDomainUnregister\fP\fR(
\fBint \fBdomain\fR\fR);
\fBvoid \fBXmLogDomainLevelSet\fP\fR(
\fBconst char *\fBdomain_name\fR\fR,
\fBint \fBlevel\fR\fR);
\fBint \fBXmLogDomainLevelGet\fP\fR(
\fBconst char *\fBdomain_name\fR\fR);
\fBvoid \fBXmLogDomainRegisteredLevelSet\fP\fR(
\fBint \fBdomain\fR\fR,
\fBint \fBlevel\fR\fR);
\fBint \fBXmLogDomainRegisteredLevelGet\fP\fR(
\fBint \fBdomain\fR\fR);
.PP
\fBvoid \fBXmLogLevelSet\fP\fR(
\fBint \fBlevel\fR\fR);
\fBint \fBXmLogLevelGet\fP\fR(\fBvoid\fR);
\fBconst char *\fBXmLogLevelColorGet\fP\fR(
