.TH "XmLog" "library call"
.nh
.SH "NAME"
\fBXmLogInit\fP,
\fBXmLogShutdown\fP,
\fBXmLogDomainRegister\fP,
\fBXmLogDomainUnregister\fP,
\fBXmLogDomainLevelSet\fP,
\fBXmLogDomainLevelGet\fP,
\fBXmLogDomainRegisteredLevelSet\fP,
\fBXmLogDomainRegisteredLevelGet\fP,
\fBXmLogLevelSet\fP,
\fBXmLogLevelGet\fP,
\fBXmLogLevelColorGet\fP,
\fBXmLogPrint\fP,
\fBXmLogPrintCbSet\fP,
\fBXmLogPrintCbStdErr\fP,
\fBXmLogPrintCbStdOut\fP,
\fBXmLogPrintCbFile\fP,
\fBXmLogSetOutput\fP,
\fBXmLogThreadsInit\fP,
\fBXmLogThreadsEnable\fP,
\fBXmLogThreadsShutdown\fP,
