\fBconst XmLogDomain *\fBd\fR\fR,
\fBXmLogLevel \fBlevel\fR\fR,
\fBconst char *\fBfile\fR\fR,
\fBconst char *\fBfnc\fR\fR,
\fBint \fBline\fR\fR,
\fBconst char *\fBfmt\fR\fR,
\fBvoid *\fBdata\fR\fR,
\fBva_list \fBargs\fR\fR);
.PP
