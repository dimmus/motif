\fBXmLogFileDisableSet\fP,
\fBXmLogFileDisableGet\fP,
\fBXmLogFunctionDisableSet\fP,
\fBXmLogFunctionDisableGet\fP \(em the Motif logging functions
.iX "XmLog"
.iX "logging functions" "XmLogInit"
.iX "logging functions" "XmLogPrint"
.SH "SYNOPSIS"
.PP
.nf
#include <Xm/Log\&.h>
.PP
\fBXmBool \fBXmLogInit\fP\fR(\fBvoid\fR);
\fBXmBool \fBXmLogShutdown\fP\fR(\fBvoid\fR);
.PP
