\fBWidget \fBw\fR\fR,
\fBPosition \fBx\fR\fR,
\fBPosition \fBy\fR\fR,
\fBDimension \fBwidth\fR\fR,
\fBDimension \fBheight\fR\fR,
\fBDimension \fBborder_width\fR\fR);
\fBvoid \fB_XmMoveWidget\fP\fR(
\fBWidget \fBw\fR\fR,
\fBPosition \fBx\fR\fR,
\fBPosition \fBy\fR\fR);
\fBvoid \fB_XmResizeWidget\fP\fR(
\fBWidget \fBw\fR\fR,
\fBDimension \fBwidth\fR\fR,
\fBDimension \fBheight\fR\fR,
\fBDimension \fBborder_width\fR\fR);
\fBXtGeometryResult \fB_XmRequestNewSize\fP\fR(
\fBWidget \fBw\fR\fR,
\fBBoolean \fBquery_only\fR\fR,
\fBDimension \fBwidth\fR\fR,
\fBDimension \fBheight\fR\fR,
\fBDimension *\fBr_width\fR\fR,
\fBDimension *\fBr_height\fR\fR);
\fBXtGeometryResult \fB_XmHWQuery\fP\fR(
\fBWidget \fBw\fR\fR,
\fBXtWidgetGeometry *\fBintended\fR\fR,
\fBXtWidgetGeometry *\fBpreferred\fR\fR);
.PP
